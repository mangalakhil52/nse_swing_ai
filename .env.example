# =====================================================================
# NSE Swing AI Configuration Environment Variables
# =====================================================================

# Database Configuration (Defaults to local SQLite if PostgreSQL is not specified)
# For SQLite: sqlite+aiosqlite:///./data/nse_swing_ai.db
# For PostgreSQL: postgresql+asyncpg://postgres:password@localhost:5432/nse_swing_ai
DATABASE_URL=sqlite+aiosqlite:///./data/nse_swing_ai.db

# Storage & Data Cache Directories
DATA_DIR=./data
CACHE_DIR=./data/cache
LOG_DIR=./logs

# Trading & Risk Parameters
ACCOUNT_CAPITAL=1000000.0
MAX_RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_HEAT_PCT=4.0
MAX_POSITIONS=3
MIN_ADTV_CRORES=5.0
MAX_STOP_LOSS_PCT=8.0
MIN_RR_TARGET_1=1.8

# Data Provider Configuration
NSE_BASE_URL=https://www.nseindia.com
CHARTINK_BASE_URL=https://chartink.com
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# Notification Channels (Optional - Leave empty to print to console/log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging & Model Versioning
LOG_LEVEL=INFO
MODEL_VERSION=v1.0.0
PROMPT_VERSION=v1.0.0
